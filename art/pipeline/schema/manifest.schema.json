{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Art asset manifest",
  "description": "Per-game list of assets the art pipeline must produce. Engine-neutral.",
  "type": "object",
  "required": ["game", "style_bible", "assets"],
  "properties": {
    "game": { "type": "string", "description": "Game id, e.g. 'clinch'." },
    "style_bible": { "type": "string", "description": "Path to the style-bible.json this manifest uses." },
    "pipeline_version": { "type": "string" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/definitions/asset" }
    }
  },
  "definitions": {
    "asset": {
      "type": "object",
      "required": ["id", "class", "intent", "spec"],
      "properties": {
        "id": { "type": "string", "description": "Stable kebab-case id, e.g. 'arena-floor'." },
        "class": {
          "type": "string",
          "enum": ["sprite", "tileset", "background", "ui", "icon", "keyart"],
          "description": "Selects the prompt template family and default conform ops."
        },
        "intent": {
          "type": "string",
          "description": "Plain-language subject the art director turns into a prompt, e.g. 'top-down arena floor'."
        },
        "family": {
          "type": "string",
          "description": "Optional grouping for consistency (shared seed/reference), e.g. 'enemies'."
        },
        "spec": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "transparent": { "type": "boolean", "default": false },
            "tiling": { "type": "boolean", "default": false, "description": "Must wrap seamlessly." },
            "pixel_art": { "type": "boolean", "default": false, "description": "Nearest-neighbour resize, no smoothing." },
            "pivot": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "default": [0.5, 0.5] },
            "pixels_per_unit": { "type": "number", "default": 100, "description": "Unity PPU; also informs Phaser scale." },
            "palette_snap": { "type": "boolean", "default": false, "description": "Snap colours to the style bible." }
          }
        },
        "generate": {
          "type": "object",
          "properties": {
            "oversample": { "type": "number", "default": 2, "description": "Generate at this multiple of target, then downscale." },
            "seed": { "type": ["integer", "null"], "default": null },
            "n": { "type": "integer", "default": 1, "description": "Candidates per attempt." },
            "reference": { "type": ["string", "null"], "default": null, "description": "Optional reference image to condition on." }
          }
        },
        "accept": {
          "type": "object",
          "description": "Stage-4 thresholds; omitted fields fall back to pipeline defaults.",
          "properties": {
            "palette_delta_e_max": { "type": "number", "default": 12 },
            "tiling_edge_diff_max": { "type": "number", "default": 8 },
            "require_alpha": { "type": "boolean" },
            "visual_check": { "type": "boolean", "default": true }
          }
        },
        "max_attempts": { "type": "integer", "default": 3 }
      }
    }
  }
}
